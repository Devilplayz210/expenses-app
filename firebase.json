{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "server.py",
      "package.json",
      "package-lock.json",
      "node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/signin",
        "destination": "/signin.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
